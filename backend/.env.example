# ---- Kadak AirMenu backend env ----
# Local dev: leave TURSO_* blank to use a local SQLite file (local.db).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Manager dashboard password (choose something long & private)
MANAGER_PASSWORD=change-me-please

# Cloudinary (image uploads). Either set CLOUDINARY_URL, or the three below.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Port (Render sets this automatically)
PORT=4000
